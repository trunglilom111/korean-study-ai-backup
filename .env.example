# Dán khóa thật vào .env.local, không commit tệp đó lên Git.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
GEMINI_API_KEY=your-gemini-api-key
TOPIK_GEMINI_MODEL=gemini-3.6-flash
TOPIK_AI_DAILY_LIMIT=40
TOPIK_AI_TIMEOUT_MS=25000
# Đặt theo bảng giá hiện hành nếu muốn tính chi phí ước lượng; để trống sẽ chỉ ghi token usage.
TOPIK_AI_INPUT_USD_PER_MILLION=
TOPIK_AI_OUTPUT_USD_PER_MILLION=
